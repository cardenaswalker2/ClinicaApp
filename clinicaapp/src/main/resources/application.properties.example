# ==================================================
# CONFIGURACIÓN DE EJEMPLO - CLINICAAPP
# Copia este archivo como application.properties o define
# estas variables de entorno antes de ejecutar la app.
# ==================================================

spring.application.name=clinica-app
server.port=${PORT:8080}

# Límites de subida de archivos
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# ==================================================
# MONGODB
# ==================================================
spring.data.mongodb.uri=${MONGODB_URI:mongodb://localhost:27017/clinica_veterinaria_db}
spring.data.mongodb.database=clinica_veterinaria_db

# ==================================================
# THYMELEAF
# ==================================================
spring.thymeleaf.mode=HTML
spring.thymeleaf.cache=false
spring.thymeleaf.encoding=UTF-8
spring.messages.encoding=UTF-8
server.servlet.encoding.charset=UTF-8
server.servlet.encoding.force=true

# ==================================================
# STRIPE (MODO DE PRUEBA)
# ==================================================
stripe.api.key.public=${STRIPE_PUBLIC_KEY:pk_test_tu_clave_publica}
stripe.api.key.secret=${STRIPE_SECRET_KEY:sk_test_tu_clave_secreta}

# ==================================================
# CORREO ELECTRÓNICO (SMTP / GMAIL)
# ==================================================
spring.mail.host=smtp.gmail.com
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:tu_correo@gmail.com}
spring.mail.password=${MAIL_PASSWORD:tu_app_password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=${MAIL_STARTTLS:true}
spring.mail.properties.mail.smtp.ssl.enable=${MAIL_SSL:false}

# ==================================================
# TWILIO (SMS / NOTIFICACIONES)
# ==================================================
twilio.account-sid=${TWILIO_ACCOUNT_SID:tu_account_sid}
twilio.auth-token=${TWILIO_AUTH_TOKEN:tu_auth_token}
twilio.phone-number=${TWILIO_PHONE_NUMBER:+10000000000}

# ==================================================
# OAUTH2 (GOOGLE Y GITHUB)
# ==================================================
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:tu_google_client_id}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:tu_google_client_secret}
spring.security.oauth2.client.registration.google.scope=openid, profile, email

spring.security.oauth2.client.registration.github.client-id=${GITHUB_CLIENT_ID:tu_github_client_id}
spring.security.oauth2.client.registration.github.client-secret=${GITHUB_CLIENT_SECRET:tu_github_client_secret}

# ==================================================
# INTEGRACIÓN LLM (GROQ API)
# ==================================================
groq.api.key=${GROQ_API_KEY:tu_groq_api_key}
groq.api.url=https://api.groq.com/openai/v1/chat/completions
groq.api.model=${GROQ_API_MODEL:openai/gpt-oss-20b}

